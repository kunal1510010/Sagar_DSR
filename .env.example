# ---- Sagar DSR environment ----
# PostgreSQL connection string (Neon / Render / Supabase / Railway / local).
# Example (Neon): postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Secret used to sign login tokens. Use a long random string in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the server listens on (most hosts set this automatically).
PORT=3000

# Set to "off" ONLY for a local Postgres that has no SSL. Leave unset in the cloud.
# PGSSL=off
